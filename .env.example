# Data (without it the app runs on clearly labelled sample data)
SOSOVALUE_API_KEY=

# Agent (without it Buffer runs rules-only)
ANTHROPIC_API_KEY=
BUFFER_MODEL=claude-haiku-5-5

# Login — Privy (without these the app uses a local "preview" sign-in)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → Configuration → App settings → Verification key (PEM). Newlines may be written as \n.
PRIVY_VERIFICATION_KEY=

# SoDEX trading (scripts/test-order.ts)
SODEX_NETWORK=testnet
SODEX_ADDRESS=
SODEX_PRIVATE_KEY=
SODEX_API_KEY_NAME=
