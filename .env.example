# ── Data (without it the app runs on clearly labelled sample data)
SOSOVALUE_API_KEY=

# ── Agent (without it Buffer runs rules-only)
ANTHROPIC_API_KEY=
BUFFER_MODEL=claude-haiku-5-5

# ── Login: Privy (without these the app uses a local "preview" sign-in)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → Configuration → App settings → Verification key (PEM). Newlines may be written as \n.
PRIVY_VERIFICATION_KEY=

# ── Executor
# Any long random string. Encrypts users' SoDEX trading keys at rest (AES-256-GCM). Never change it once keys are stored.
BUFFER_ENCRYPTION_KEY=
# Shared secret for /api/cron/tick (Vercel Cron sends it automatically; the GitHub Action reads it from repo secrets).
CRON_SECRET=
# SoDEX network for user trading: testnet (default) or mainnet
SODEX_NETWORK=testnet
# Storage. Add Vercel's Redis (Upstash) integration and these are filled in for you.
# Without them Buffer uses a local JSON file, which does NOT persist on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: wallet balance sync endpoints (defaults: mempool.space, publicnode)
BUFFER_BTC_API=
BUFFER_ETH_RPC=

# ── scripts/test-order.ts only (your own testnet account)
SODEX_ADDRESS=
SODEX_PRIVATE_KEY=
SODEX_API_KEY_NAME=
